{
  "name": "opentoken",
  "version": "0.1.0-beta",
  "private": true,
  "description": "opentoken \u2014 what it actually costs to serve open-weight models, and the ten layers between a checkpoint and a billable token",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "test": "node --test test/*.test.js",
    "test:update": "node scripts/paper-figures.mjs > test/golden/paper-figures.txt && echo 'golden transcript updated — explain the diff in your PR'",
    "start": "node server/index.js",
    "dev:server": "node server/index.js",
    "dev:web": "vite",
    "refresh:openrouter": "node server/refresh-openrouter.js",
    "refresh:snapshot": "node server/refresh-snapshot.js",
    "refresh:history": "node server/backfill-history.js",
    "refresh:paper": "node scripts/pin-paper-feeds.mjs",
    "paper:figures": "node scripts/paper-figures.mjs",
    "report:kv": "node scripts/report-kv-wanted.mjs",
    "bench": "node scripts/benchmark-tp.mjs",
    "bench:cloud": "node scripts/bench-cloud.mjs",
    "bench:ingest": "node scripts/ingest-benchmarks.mjs",
    "paper:charts": "node scripts/make-paper-charts.mjs",
    "paper:pdf": "python3 scripts/make-paper-pdf.py"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.2"
  },
  "license": "MIT",
  "author": "Hariprasad Sudharshan",
  "repository": {
    "type": "git",
    "url": "https://github.com/brettleehari/tokencalci.git"
  },
  "homepage": "https://tokencalci.onrender.com",
  "keywords": [
    "llm",
    "inference",
    "serving",
    "open-weights",
    "tco",
    "gpu",
    "vllm",
    "cost-model"
  ]
}